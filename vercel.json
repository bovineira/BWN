{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/apresentacao-comercial",
      "destination": "/apresentacao-comercial/index.html"
    },
    {
      "source": "/bovireportads",
      "destination": "/bovireportads/index.html"
    },
    {
      "source": "/bovireportads-politicas-de-privacidade",
      "destination": "/bovireportads/privacidade.html"
    },
    {
      "source": "/bovireportads-termos-de-servico",
      "destination": "/bovireportads/termos.html"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
